# Einstellungen fuer das Community-Portal
# Wird von Portal-Einrichten.bat als "portal.env" angelegt. portal.env NIEMALS weitergeben oder hochladen.

# --- Discord-Anwendung (https://discord.com/developers/applications) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Adresse, zu der Discord nach dem Login zurueckleitet. Portal-Einrichten.bat traegt die
# Server-IP automatisch ein. Muss exakt so auch in der Discord-Anwendung unter OAuth2 -> Redirects stehen.
DISCORD_REDIRECT_URI=http://SERVER-IP:29630/auth/callback

# Server-ID eures Community-Discords (Rechtsklick auf den Server -> Server-ID kopieren)
DISCORD_GUILD_ID=

# Optional: nur Mitglieder mit einer dieser Rollen-IDs zulassen (Komma-getrennt). Leer = alle Mitglieder.
DISCORD_REQUIRED_ROLE_IDS=

# --- Portal ---
PORTAL_COMMUNITY_NAME=unsere Community
# Discord-Nutzer-IDs, die die Projekt-Uebersicht sehen duerfen (Komma-getrennt)
PORTAL_ADMIN_DISCORD_IDS=
# Fuer die Datenschutz-Seite: Name des Verantwortlichen und Kontakt (E-Mail oder Discord-Name)
PORTAL_OPERATOR_NAME=
PORTAL_OPERATOR_CONTACT=

# Netzwerk: 0.0.0.0 = von aussen ueber Server-IP und Port erreichbar.
# Eigener Port statt 80/443. Wer ihn aendert, muss auch DISCORD_REDIRECT_URI, den Discord-Redirect
# und die Firewall-Freigabe anpassen (Portal-Einrichten.bat erneut als Administrator ausfuehren).
PORTAL_HOST=0.0.0.0
PORTAL_PORT=29630
# Nur auf 1 setzen, wenn das Portal spaeter ueber https:// erreichbar ist
PORTAL_HTTPS_ONLY=0

# Datenordner (Uploads, Datenbank, Berichte). Leer = Ordner "portal-data" im Projekt.
PORTAL_DATA_DIR=
PORTAL_MAX_UPLOAD_MB=400
